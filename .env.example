# Celsius: optional settings. Keep paths appropriate to this PC.
# CLI: --host and --port. LAN requires --allow-lan and HTTPS.
CELSIUS_WEB__HOST=127.0.0.1
CELSIUS_WEB__PORT=8790
CELSIUS_TELEMETRY__ENABLED=false
CELSIUS_TELEMETRY__LOG_LEVEL=INFO
CELSIUS_MODEL__LLM_MODEL=qwen2.5-vl-7b-q4km
CELSIUS_MODEL__DEFAULT_LLM_MODEL=qwen2.5-vl-7b-q4km
# CELSIUS_DATA_DIR=E:/PythonProjectCELSIUS/data
# CELSIUS_RESOURCES_DIR=E:/PythonProjectCELSIUS/resources
# Offline mode disables external services, including Edge TTS.
# CELSIUS_SECURITY__LOCAL_ONLY_MODE=true
# Extra folders the agent may read (project folder is always authorized).
# JSON array of absolute paths:
# CELSIUS_SECURITY__ALLOWED_FILE_ROOTS=["C:/MeusDocumentos","E:/Arquivos da Empresa"]
# CELSIUS_MOBILE__ENABLED=false
# CELSIUS_MOBILE__ALLOW_LAN=false
# CELSIUS_MOBILE__USE_HTTPS=true

# ---------------------------------------------------------------------------
# Camada de decisao local (JEV / System One) - kev.serve em 127.0.0.1:8009
# Subir o servidor:  powershell -ExecutionPolicy Bypass -File scripts\kev-server.ps1
# Detalhes e calibracao: docs/DECISION_LAYER.md
# ---------------------------------------------------------------------------
# CELSIUS_DECISION__ENABLED=true
# CELSIUS_DECISION__PROVIDER=local
# CELSIUS_DECISION__BASE_URL=http://127.0.0.1:8009
# CELSIUS_DECISION__MODEL=kev-latest
# CELSIUS_DECISION__TIMEOUT_MS=4000
# CELSIUS_DECISION__GUARD_RISK_THRESHOLD=0.85
# CELSIUS_DECISION__GUARD_UNCERTAINTY_BAND=0.15
# CELSIUS_DECISION__RAG_RELEVANCE_THRESHOLD=0.30
# CELSIUS_DECISION__RAG_MAX_GATED_CHUNKS=5
# CELSIUS_DECISION__MODEL_ROUTING=true
