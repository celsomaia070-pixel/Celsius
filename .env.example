# Celsius - Environment Configuration
# Copy this file to .env and modify values as needed
# All settings can be overridden via environment variables with CELSIUS_ prefix

# =============================================================================
# Environment
# =============================================================================
CELSIUS_ENVIRONMENT=development  # development, staging, production, test

# =============================================================================
# Base Directories
# =============================================================================
# CELSIUS_BASE_DIR=/path/to/app
# CELSIUS_DATA_DIR=/path/to/data
# CELSIUS_RESOURCES_DIR=/path/to/resources
# CELSIUS_LOGS_DIR=/path/to/logs

# =============================================================================
# Assistant Identity Settings (prefix: CELSIUS_ASSISTANT_)
# =============================================================================
CELSIUS_ASSISTANT_OWNER_NAME=
# Identidade fixa do produto: Celsius, Agente Multimodal Local de IA.
# Campo legado: prefira CELSIUS_CUSTOMER_USER_NAME para novas instalacoes.

# =============================================================================
# Customer / Company Profile Settings (prefix: CELSIUS_CUSTOMER_)
# =============================================================================
# Estes dados dizem ao Celsius para quem ele esta trabalhando nesta instalacao.
# Tambem podem ser salvos pela tela Configuracoes em data/customer_profile.json.
CELSIUS_CUSTOMER_USER_NAME=
CELSIUS_CUSTOMER_COMPANY_NAME=
CELSIUS_CUSTOMER_COMPANY_SECTOR=
CELSIUS_CUSTOMER_COMPANY_SIZE=
CELSIUS_CUSTOMER_USER_ROLE=
CELSIUS_CUSTOMER_PREFERRED_TONE=profissional e direto
CELSIUS_CUSTOMER_BUSINESS_CONTEXT=
CELSIUS_CUSTOMER_TIMEZONE=America/Sao_Paulo
CELSIUS_CUSTOMER_LOCAL_OFFLINE_REQUIRED=true

# =============================================================================
# Hardware Detection Settings (prefix: CELSIUS_HARDWARE_)
# =============================================================================
# auto_detect: automatically detect hardware and select optimal model
# force_mode: "auto", "leve", "completo", "custom"
# force_model: override automatic selection with specific model ID
# prefer_multimodal: prefer multimodal (vision) models when possible
CELSIUS_HARDWARE_AUTO_DETECT=true
CELSIUS_HARDWARE_FORCE_MODE=auto
CELSIUS_HARDWARE_FORCE_MODEL=
CELSIUS_HARDWARE_PREFER_MULTIMODAL=true

# =============================================================================
# Model Settings (prefix: CELSIUS_MODEL_)
# =============================================================================
CELSIUS_MODEL_DEFAULT_LLM_MODEL=qwen2.5-vl-7b-q4km
CELSIUS_MODEL_LLM_MODEL=qwen2.5-vl-7b-q4km
CELSIUS_MODEL_FAST_LLM_MODEL=qwen3-4b-q4km
CELSIUS_MODEL_QUALITY_LLM_MODEL=qwen3-14b-q4km
CELSIUS_MODEL_REASONING_LLM_MODEL=deepseek-r1-distill-qwen-7b-q4km
CELSIUS_MODEL_VISION_LLM_MODEL=qwen2.5-vl-7b-q4km
CELSIUS_MODEL_EMBEDDING_MODEL=qwen3-embedding-0.6b
CELSIUS_MODEL_WHISPER_MODEL=small
CELSIUS_MODEL_NUM_CTX=16384
CELSIUS_MODEL_NUM_PREDICT=2500
CELSIUS_MODEL_N_GPU_LAYERS=-1
CELSIUS_MODEL_N_BATCH=1024
CELSIUS_MODEL_N_THREADS=0
CELSIUS_MODEL_USE_MMAP=true
CELSIUS_MODEL_USE_MLOCK=true
CELSIUS_MODEL_OFFLOAD_KQV=true
CELSIUS_MODEL_FLASH_ATTN=true

# =============================================================================
# Response Style Settings (prefix: CELSIUS_RESPONSE_)
# =============================================================================
CELSIUS_RESPONSE_MODE=natural  # natural, tecnico, relatorio
CELSIUS_RESPONSE_TEMPERATURE=0.45
CELSIUS_RESPONSE_TOP_P=0.9
CELSIUS_RESPONSE_SHORT_ANSWER_MAX_CHARS=180
CELSIUS_RESPONSE_MAX_SIMPLE_SENTENCES=3

# =============================================================================
# RAG Settings (prefix: CELSIUS_RAG_)
# =============================================================================
CELSIUS_RAG_CHUNK_SIZE=600
CELSIUS_RAG_CHUNK_OVERLAP=80
CELSIUS_RAG_TOP_K=5
CELSIUS_RAG_FINAL_TOP_K=3
CELSIUS_RAG_DISTANCE_THRESHOLD=1.5
CELSIUS_RAG_ENABLE_HYBRID_SEARCH=true
CELSIUS_RAG_BM25_WEIGHT=0.3
CELSIUS_RAG_DENSE_WEIGHT=0.7
CELSIUS_RAG_ENABLE_RERANKING=true
CELSIUS_RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CELSIUS_RAG_RERANK_TOP_K=10

# =============================================================================
# Memory Settings (prefix: CELSIUS_MEMORY_)
# =============================================================================
CELSIUS_MEMORY_MAX_HISTORY_SESSION=16
CELSIUS_MEMORY_MEMORY_THRESHOLD=0.15
CELSIUS_MEMORY_TOP_MEMORIES=10
CELSIUS_MEMORY_INJECT_ALL_MEMORIES_LIMIT=15

# =============================================================================
# File Settings (prefix: CELSIUS_FILE_)
# =============================================================================
CELSIUS_FILE_MAX_FILE_SIZE_MB=50
CELSIUS_FILE_DOC_TEXT_LIMIT=12000

# =============================================================================
# Inventory Settings (prefix: CELSIUS_INVENTORY_)
# =============================================================================
CELSIUS_INVENTORY_ENABLED=true
CELSIUS_INVENTORY_DEFAULT_MIN_STOCK=5
CELSIUS_INVENTORY_DEFAULT_MAX_STOCK=100

# =============================================================================
# Security Settings (prefix: CELSIUS_SECURITY_)
# =============================================================================
CELSIUS_SECURITY_SANDBOX_ENABLED=true
CELSIUS_SECURITY_SANDBOX_MAX_MEMORY_MB=256
CELSIUS_SECURITY_SANDBOX_MAX_CPU_SECONDS=30
CELSIUS_SECURITY_PATH_TRAVERSAL_PROTECTION=true
# JSON array. Empty means only the app base directory is authorized.
# CELSIUS_SECURITY_ALLOWED_FILE_ROOTS=["E:/PythonProjectCELSIUS","E:/Empresa/Documentos"]

# =============================================================================
# Telemetry Settings (prefix: CELSIUS_TELEMETRY_)
# =============================================================================
CELSIUS_TELEMETRY_ENABLED=false
CELSIUS_TELEMETRY_OTLP_ENDPOINT=http://localhost:4317
CELSIUS_TELEMETRY_OTLP_INSECURE=true
CELSIUS_TELEMETRY_SERVICE_NAME=celsius
CELSIUS_TELEMETRY_SERVICE_VERSION=1.0.0
CELSIUS_TELEMETRY_SAMPLE_RATE=1.0
CELSIUS_TELEMETRY_LOG_LEVEL=INFO
CELSIUS_TELEMETRY_METRICS_ENABLED=true
CELSIUS_TELEMETRY_METRICS_PORT=9090

# =============================================================================
# UI Settings (prefix: CELSIUS_UI_)
# =============================================================================
CELSIUS_UI_THEME=light  # light, dark, system
CELSIUS_UI_LANGUAGE=pt-BR
CELSIUS_UI_FONT_SIZE=10
CELSIUS_UI_SHOW_SIDEBAR=true
CELSIUS_UI_ANIMATION_ENABLED=true
CELSIUS_UI_COMMAND_PALETTE_ENABLED=true
CELSIUS_UI_JARVIS_ENABLED=true
CELSIUS_UI_JARVIS_PARTICLE_COUNT=800
CELSIUS_UI_JARVIS_FPS=60

# =============================================================================
# Voice Settings (prefix: CELSIUS_VOICE_)
# =============================================================================
CELSIUS_VOICE_ENABLED=true
CELSIUS_VOICE_PROVIDER=edge-tts
CELSIUS_VOICE_VOICE=pt-BR-AntonioNeural
CELSIUS_VOICE_RATE=+5%
CELSIUS_VOICE_PITCH=-2Hz
CELSIUS_VOICE_VOLUME=+0%
CELSIUS_VOICE_MAX_PLAYBACK_MS=120000

# =============================================================================
# Mobile Access Settings (prefix: CELSIUS_MOBILE_)
# =============================================================================
# Desligado por padrao. Ative pela interface ou por variaveis de ambiente.
CELSIUS_MOBILE_ENABLED=false
CELSIUS_MOBILE_HOST=0.0.0.0
CELSIUS_MOBILE_PORT=8787
CELSIUS_MOBILE_ALLOW_LAN=false
CELSIUS_MOBILE_VOICE_COMMANDS_ENABLED=true
CELSIUS_MOBILE_USE_HTTPS=true
# Deixe vazio para o Celsius gerar um token forte localmente.
CELSIUS_MOBILE_PAIRING_TOKEN=

# =============================================================================
# Notifications / External Channels Settings (prefix: CELSIUS_NOTIFICATIONS_)
# =============================================================================
# WhatsApp, e-mail e SMS dependem de internet e servico externo.
CELSIUS_NOTIFICATIONS_ENABLED=false
CELSIUS_NOTIFICATIONS_EXTERNAL_SERVICES_ALLOWED=false
CELSIUS_NOTIFICATIONS_REQUIRE_CONFIRMATION=true
CELSIUS_NOTIFICATIONS_DEFAULT_CHANNEL=whatsapp
CELSIUS_NOTIFICATIONS_WHATSAPP_PROVIDER=meta_cloud_api
CELSIUS_NOTIFICATIONS_WHATSAPP_PHONE_NUMBER_ID=
# Guarde o token real em uma variavel de ambiente, nao no arquivo local.
CELSIUS_NOTIFICATIONS_WHATSAPP_TOKEN_ENV_VAR=CELSIUS_WHATSAPP_TOKEN
CELSIUS_NOTIFICATIONS_EMAIL_PROVIDER=
CELSIUS_NOTIFICATIONS_EMAIL_FROM=
CELSIUS_NOTIFICATIONS_SMS_PROVIDER=
CELSIUS_NOTIFICATIONS_SMS_SENDER_ID=

# =============================================================================
# Feature Flags (prefix: CELSIUS_FEATURE_)
# =============================================================================
CELSIUS_FEATURE_CONVERSATIONS=true
CELSIUS_FEATURE_INVENTORY=true
CELSIUS_FEATURE_RAG=true
CELSIUS_FEATURE_MEMORY=true
CELSIUS_FEATURE_WEB_SEARCH=true
CELSIUS_FEATURE_WEB_BROWSER=true
CELSIUS_FEATURE_CODE_EXECUTION=true
CELSIUS_FEATURE_VOICE_INPUT=true
CELSIUS_FEATURE_VOICE_OUTPUT=true
CELSIUS_FEATURE_IMAGE_ANALYSIS=true
CELSIUS_FEATURE_DOCUMENT_PROCESSING=true
CELSIUS_FEATURE_REPORT_GENERATION=true
CELSIUS_FEATURE_MULTI_AGENT=true
CELSIUS_FEATURE_MODEL_ROUTER=true
